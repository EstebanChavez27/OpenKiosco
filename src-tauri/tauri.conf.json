{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenKiosco",
  "version": "0.1.0",
  "identifier": "com.openkiosco.desktop",
  "build": {
    "frontendDist": "../apps/web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev -w apps/web",
    "beforeBuildCommand": "npm run build -w apps/web"
  },
  "app": {
    "appImageIfNoIcon": false,
    "withGlobalTauri": false,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "OpenKiosco",
        "url": "http://127.0.0.1:4820/",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage"],
    "category": "Office",
    "copyright": "© 2026 OpenKiosco. Open source.",
    "publisher": "OpenKiosco",
    "shortDescription": "POS liviano para kioscos y almacenes",
    "longDescription": "OpenKiosco es un punto de venta open source para comercios de barrio, con turnos de caja con arqueo a ciegas, libreta de fiados, inventario y soporte de pagos mixtos.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/api": "api",
      "resources/web": "web",
      "resources/runtime": "runtime"
    },
    "windows": {
      "nsis": {
        "license": null,
        "languages": ["SpanishInternational", "English"],
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "displayLanguageSelector": true,
        "startMenuFolder": "OpenKiosco"
      },
      "wix": {
        "language": ["es-AR", "en-US"]
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libgtk-3-0",
          "librsvg2-2",
          "libssl3 | libssl1.1"
        ],
        "section": "utils",
        "priority": "optional"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}